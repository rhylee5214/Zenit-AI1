{
  "run_name": "zenit-2.0-sft",
  "version": "2.0",
  "stage": "sft",
  "base_model": "Qwen/Qwen3-4B-Base",
  "base_license": "Apache-2.0",
  "manifest": "data/manifests/zenit-2.0-sft.json",
  "persona_data": "data/sft/zenit_persona.jsonl",
  "persona_weight": 3,
  "max_seq_len": 2048,
  "max_examples": 20000,
  "load_in_4bit": "auto",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": "all-linear",
  "lr": 0.0002,
  "epochs": 1,
  "batch_size": 2,
  "grad_accum": 8,
  "warmup_ratio": 0.03,
  "logging_steps": 10,
  "eval_steps": 200,
  "save_steps": 500,
  "gradient_checkpointing": true,
  "chat_template_kwargs": {"enable_thinking": false}
}
